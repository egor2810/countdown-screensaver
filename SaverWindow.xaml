<Window x:Class="CountdownSaver.SaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CountdownSaver"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Topmost="True" ShowInTaskbar="False" Cursor="None"
        Background="#0B0714" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Row" TargetType="TextBlock">
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="UnitRun" TargetType="Run">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
        </Style>
        <Style x:Key="SysLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SysValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="SysExtra" TargetType="TextBlock" BasedOn="{StaticResource SysValue}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- Живой фон: цветные пятна плывут как в ambient-лампе -->
        <Viewbox Stretch="UniformToFill">
            <Canvas x:Name="AmbientCanvas" Width="1920" Height="1080"/>
        </Viewbox>
        <!-- Затемнение для читаемости текста -->
        <Rectangle Fill="#38000000"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A000000" Offset="0"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewbox x:Name="ContentBox" Stretch="Uniform">
            <Grid x:Name="Layout" Width="1920" Height="1080">
                <!-- Часы и дата -->
                <StackPanel x:Name="ClockPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,80,0">
                    <TextBlock x:Name="ClockText" FontSize="68" FontWeight="Light" HorizontalAlignment="Right"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="DateText" FontSize="24" Foreground="#99FFFFFF" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Загрузка и температуры -->
                <StackPanel x:Name="SystemPanel" Width="470" Margin="0,0,80,70"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Grid x:Name="CpuRow" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CpuLabel" Style="{StaticResource SysLabel}"/>
                        <Grid Grid.Column="1" Height="4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Fill="White" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="CpuBar" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="CpuLoadText" Grid.Column="2" Style="{StaticResource SysValue}"/>
                        <TextBlock x:Name="CpuExtraText" Grid.Column="3" Style="{StaticResource SysExtra}"/>
                    </Grid>
                    <Grid x:Name="RamRow" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RamLabel" Style="{StaticResource SysLabel}"/>
                        <Grid Grid.Column="1" Height="4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Fill="White" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RamBar" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="RamLoadText" Grid.Column="2" Style="{StaticResource SysValue}"/>
                        <TextBlock x:Name="RamExtraText" Grid.Column="3" Style="{StaticResource SysExtra}"/>
                    </Grid>
                    <Grid x:Name="GpuRow" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GpuLabel" Style="{StaticResource SysLabel}"/>
                        <Grid Grid.Column="1" Height="4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Fill="White" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="GpuBar" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="GpuLoadText" Grid.Column="2" Style="{StaticResource SysValue}"/>
                        <TextBlock x:Name="GpuExtraText" Grid.Column="3" Style="{StaticResource SysExtra}"/>
                    </Grid>
                </StackPanel>

                <!-- Слева: большая обложка и трек -->
                <StackPanel x:Name="MediaPanel" Width="560" Margin="150,0,0,0" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Width="560" Height="560">
                        <Border CornerRadius="28" Background="#000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="90" ShadowDepth="30" Direction="270"
                                                  Opacity="0.55" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,560,560" RadiusX="28" RadiusY="28"/>
                            </Grid.Clip>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="♪" FontSize="200" Foreground="#60FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="SourceText" FontSize="15" Foreground="#99FFFFFF" Margin="0,34,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SongText" FontSize="44" FontWeight="Bold" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="120"
                               LineStackingStrategy="BlockLineHeight" LineHeight="56"/>
                    <TextBlock x:Name="ArtistText" FontSize="28" Foreground="#C0FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="ProgressRow" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" FontSize="15" Foreground="#99FFFFFF"
                                   Typography.NumeralAlignment="Tabular"/>
                        <Grid Grid.Column="1" Height="4" Margin="12,0" VerticalAlignment="Center">
                            <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Fill="White" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="15" Foreground="#99FFFFFF"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </StackPanel>

                <!-- Справа: обратный отсчёт столбиком (без музыки — по центру экрана) -->
                <StackPanel x:Name="CountdownColumn" Margin="880,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="26" Foreground="#A6FFFFFF" Margin="4,0,0,8"/>

                    <StackPanel x:Name="CountdownRows">
                        <TextBlock x:Name="DaysRow" Style="{StaticResource Row}" LineHeight="200">
                            <Run x:Name="DaysNum" FontSize="190" FontWeight="Bold"/><Run Text="  " FontSize="40"/><Run x:Name="DaysUnit" FontSize="40" Style="{StaticResource UnitRun}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Row}" LineHeight="132">
                            <Run x:Name="HoursNum" FontSize="120" FontWeight="Light"/><Run Text="   " FontSize="30"/><Run x:Name="HoursUnit" FontSize="30" Style="{StaticResource UnitRun}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Row}" LineHeight="132">
                            <Run x:Name="MinutesNum" FontSize="120" FontWeight="Light"/><Run Text="   " FontSize="30"/><Run x:Name="MinutesUnit" FontSize="30" Style="{StaticResource UnitRun}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Row}" LineHeight="132">
                            <Run x:Name="SecondsNum" FontSize="120" FontWeight="Light"/><Run Text="   " FontSize="30"/><Run x:Name="SecondsUnit" FontSize="30" Style="{StaticResource UnitRun}"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="DoneText" FontSize="110" FontWeight="Bold" Visibility="Collapsed"
                               TextWrapping="Wrap" MaxWidth="900" LineStackingStrategy="BlockLineHeight" LineHeight="124"/>

                    <TextBlock x:Name="InfoText" FontSize="22" Foreground="#73FFFFFF" Margin="4,30,0,0"/>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- Только в отладочном режиме (/w) -->
        <TextBlock x:Name="DebugText" Visibility="Collapsed" Margin="12" FontSize="13"
                   FontFamily="Consolas" Foreground="#FFFF8080" TextWrapping="Wrap"
                   VerticalAlignment="Top" HorizontalAlignment="Left"/>
    </Grid>
</Window>
